<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil/"
     xml:base="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil/1.0"/>
        <owl:imports rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#concernsNutrient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#concernsNutrient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasAvailableNutrient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasAvailableNutrient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNitrogenLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNitrogenLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNutrientLevel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNutrientLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNutrientLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasPhosphorusLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasPhosphorusLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNutrientLevel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasPotassiumLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasPotassiumLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNutrientLevel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasSoilFertilityStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasSoilFertilityStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:ObjectProperty>


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasSoilStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasSoilStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasCEC -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasCEC">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasOrganicMatter -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasOrganicMatter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasSoilPH -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasSoilPH">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasUnit -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasUnit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#NutrientLevel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#CEC -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#CEC"/>
    






















    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#OrganicMatter -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#OrganicMatter"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorNitrogenSoil -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorNitrogenSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorPhosphorusSoil -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorPhosphorusSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorPotassiumSoil -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorPotassiumSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#RichNitrogenSoil -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#RichNitrogenSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#RichPhosphorus -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#RichPhosphorus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#RichPotassium -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#RichPotassium">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>

    <!-- Medium nutrient soil classes -->
    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#MediumNitrogenSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#MediumPhosphorusSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#MediumPotassiumSoil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilFertilityStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#LowNutrients -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#LowNutrients">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#MediumNutrients -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#MediumNutrients">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#HighNutrients -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#HighNutrients">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilStatus"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilPH -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilPH"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilProperty -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilProperty"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilTexture -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#SoilTexture"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    









    <!-- SWRL variables for soil-level rules -->
    <rdf:Description rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#s">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#lvl">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#v">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>

    <!-- Soil profile rules (Nitrogen example) -->
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:label>PoorNitrogenSoilRule</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNitrogenLevel"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#s"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#lvl"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#hasValue"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#lvl"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#v"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#PoorNitrogenSoil"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>

    <!-- Medium Nitrogen soil rule (20 <= v < 50) -->
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:label>MediumNitrogenSoilRule</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#hasNitrogenLevel"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#s"/>
                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#lvl"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Nutriment#hasValue"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#lvl"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                        <swrl:arguments>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#v"/>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </swrl:arguments>
                                    </rdf:Description>
                                </rdf:first>
