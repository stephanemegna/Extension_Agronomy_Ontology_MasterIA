    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/practice#AgriculturalPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/practice#AgriculturalPractice"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#AgriculturalSituation -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#AgriculturalSituation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#hasClimate"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Climate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#hasCrop"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/crop#Crop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#hasPractice"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/practice#AgriculturalPractice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#hasSoil"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/Soil#Soil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


