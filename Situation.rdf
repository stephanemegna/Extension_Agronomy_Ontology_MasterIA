    <!-- Agricultural situations for maize tests -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#Maize_Situation_Favorable">
        <rdf:type rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#AgriculturalSituation"/>
        <situation:hasSoil rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#Soil_Maize_Favorable"/>
        <situation:hasClimate rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Climate_Favorable"/>
