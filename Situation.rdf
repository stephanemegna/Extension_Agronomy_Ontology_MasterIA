     -->

    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Climate -->

    <rdf:Description rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Climate">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#hasTemperature"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Humidity -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Humidity"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#LowRainfall -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#LowRainfall"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Precipitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Precipitation"/>
    


    <!-- http://www.semanticweb.org/megnastephane/ontologies/2026/3/climate#Rainfall -->

