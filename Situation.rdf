    <owl:Class rdf:about="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#LowTemperatureStress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/megnastephane/ontologies/2026/3/situation#ConditionTemperature"/>
    </owl:Class>
    


